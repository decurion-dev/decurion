{
  "mcpServers": {
    "browser": {
      "type": "stdio",
      "command": "/usr/local/bin/playwright-mcp",
      "args": [
        "--browser", "chromium",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--no-webmcp",
        "--proxy-server", "http://gate:3128",
        "--proxy-bypass", "localhost,127.0.0.1,[::1]",
        "--output-dir", "/tmp/playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
        "PLAYWRIGHT_DISABLE_FORCED_CHROMIUM_PROXIED_LOOPBACK": "1"
      }
    }
  }
}
